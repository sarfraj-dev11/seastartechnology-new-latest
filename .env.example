# ─── Database Configuration ───────────────────────────────
# For Hostinger: Get these from hPanel → Databases → MySQL
# For Local (XAMPP): Use root with no password

DB_HOST=localhost
DB_NAME=your_database_name_here
DB_USER=your_database_user_here
DB_PASS=your_database_password_here
DB_CHARSET=utf8mb4
